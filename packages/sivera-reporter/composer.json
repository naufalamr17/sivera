{
    "name": "naufalamr17/sivera-reporter",
    "description": "Fail-safe Laravel exception reporter for SIVERA",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "sivera", "exceptions", "monitoring"],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mlp\\SiveraReporter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mlp\\SiveraReporter\\SiveraServiceProvider"
            ]
        }
    }
}
